			"item": [
				{
					"name": "/topsofthetops",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {\r",
									"    pm.response.to.have.status(200);\r",
									"});\r",
									"\r",
									"pm.test(\"Response is an array\", function () {\r",
									"    pm.expect(pm.response.json()).to.be.an(\"array\");\r",
									"});\r",
									"\r",
									"pm.test(\"Each item has required keys and correct types\", function () {\r",
									"    const items = pm.response.json();\r",
									"    items.forEach(item => {\r",
									"        pm.expect(item).to.have.property(\"game_id\").that.is.a(\"string\");\r",
									"        pm.expect(item).to.have.property(\"game_name\").that.is.a(\"string\");\r",
									"        pm.expect(item).to.have.property(\"user_name\").that.is.a(\"string\");\r",
									"        pm.expect(item).to.have.property(\"total_videos\").that.is.a(\"number\");\r",
									"        pm.expect(item).to.have.property(\"total_views\").that.is.a(\"number\");\r",
									"        pm.expect(item).to.have.property(\"most_viewed_title\").that.is.a(\"string\");\r",
									"        pm.expect(item).to.have.property(\"most_viewed_views\").that.is.a(\"number\");\r",
									"        pm.expect(item).to.have.property(\"most_viewed_duration\").that.is.a(\"string\");\r",
									"        pm.expect(item).to.have.property(\"most_viewed_created_at\").that.is.a(\"string\");\r",
									"    });\r",
									"});\r",
									"\r",
									"pm.test(\"Duration fields match expected format\", function () {\r",
									"    const items = pm.response.json();\r",
									"    const durationRegex = /^\\d+h\\d+m\\d+s$/;\r",
									"    items.forEach(item => {\r",
									"        pm.expect(item.most_viewed_duration).to.match(durationRegex);\r",
									"    });\r",
									"});\r",
									"\r",
									"pm.test(\"Total views is greater than 0\", function () {\r",
									"    const items = pm.response.json();\r",
									"    items.forEach(item => {\r",
									"        pm.expect(item.total_views).to.be.above(0);\r",
									"    });\r",
									"});\r",
									"\r",
									"pm.test(\"Most viewed views not exceeding total views\", function () {\r",
									"    const items = pm.response.json();\r",
									"    items.forEach(item => {\r",
									"        pm.expect(item.most_viewed_views).to.be.at.most(item.total_views);\r",
									"    });\r",
									"});\r",
									""
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
					],
